# Copy to .env (never commit .env). Values are read only by the backend process.

# API Key ID shown on Kalshi's "Account & security -> API Keys" page.
KALSHI_KEY_ID=

# Private key text, pasted between the double quotes. Multi-line paste is fine as long as
# it stays inside the quotes. Include the -----BEGIN ...----- and -----END ...----- lines.
KALSHI_PRIVATE_KEY="
"

# Alternative to KALSHI_PRIVATE_KEY: path to a PEM file (relative to the repo root).
# Only used when KALSHI_PRIVATE_KEY is empty.
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-read.pem
